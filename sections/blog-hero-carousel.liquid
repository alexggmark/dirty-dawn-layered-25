{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'component-slideshow.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .blog-hero-carousel .banner__box {
    text-align: left;
    padding: 3rem 3.5rem;
    max-width: 50rem;
  }

  .blog-hero-carousel .banner__box * {
    text-align: left;
  }

  .blog-hero-carousel__meta {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 1.5rem;
    font-size: 1.2rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .blog-hero-carousel__category {
    font-weight: 600;
  }

  .blog-hero-carousel__date {
    color: rgba(var(--color-foreground), 0.55);
  }

  .blog-hero-carousel__meta-separator {
    color: rgba(var(--color-foreground), 0.35);
  }

  .blog-hero-carousel__title {
    font-family: var(--font-heading-family);
    font-size: 3.6rem;
    line-height: 1.15;
    margin: 0 0 1.5rem;
    font-weight: 400;
  }

  .blog-hero-carousel__excerpt {
    font-size: 1.4rem;
    line-height: 1.6;
    color: rgba(var(--color-foreground), 0.75);
    margin-bottom: 1.2rem;
  }

  .blog-hero-carousel__author {
    font-size: 1.3rem;
    margin-bottom: 2rem;
    color: rgba(var(--color-foreground), 0.65);
  }

  .blog-hero-carousel__cta {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    min-height: 4.5rem;
    padding: 0 3rem;
    border: 0.1rem solid rgb(var(--color-foreground));
    background: transparent;
    text-decoration: none;
    text-transform: uppercase;
    font: inherit;
    font-size: 1.4rem;
    letter-spacing: 0.1em;
    color: rgb(var(--color-foreground));
    transition: background-color 0.2s, color 0.2s;
  }

  .blog-hero-carousel__cta:hover {
    background-color: rgb(var(--color-foreground));
    color: rgb(var(--color-background));
  }

  @media screen and (max-width: 749px) {
    .blog-hero-carousel.banner--small .slideshow__slide {
      min-height: 28rem;
    }
    .blog-hero-carousel.banner--medium .slideshow__slide {
      min-height: 34rem;
    }
    .blog-hero-carousel.banner--large .slideshow__slide {
      min-height: 39rem;
    }

    .blog-hero-carousel .slideshow__slide {
      position: relative;
    }

    .blog-hero-carousel .banner__media {
      position: absolute;
      inset: 0;
    }

    .blog-hero-carousel .banner__content {
      position: absolute;
      inset: 0;
      height: auto;
      align-items: flex-end;
      padding: 1.5rem;
    }

    .blog-hero-carousel .banner__box {
      padding: 2rem 2.5rem;
      max-width: 100%;
      background: rgb(var(--color-background)) !important;
      border-radius: 0;
      text-align: center;
    }

    .blog-hero-carousel .banner__box * {
      text-align: center;
    }

    .blog-hero-carousel__meta {
      justify-content: center;
    }

    .blog-hero-carousel__title {
      font-size: 2.4rem;
    }

    .blog-hero-carousel__excerpt {
      display: none;
    }
  }
{%- endstyle -%}

{%- liquid
  assign blog = blogs[section.settings.blog]
  assign article_count = section.settings.articles_to_show
  assign slide_height = section.settings.slide_height
  assign overlay_opacity = section.settings.image_overlay_opacity | divided_by: 100.0
-%}

{%- if blog != blank and blog.articles_count > 0 -%}
  {%- assign articles = blog.articles | slice: 0, article_count -%}

  <slideshow-component
    class="slider-mobile-gutter"
    role="region"
    aria-roledescription="{{ 'sections.slideshow.carousel' | t }}"
    aria-label="{{ section.settings.accessibility_info | default: 'Blog hero carousel' | escape }}"
  >
    <div
      class="slideshow banner banner--{{ slide_height }} grid grid--1-col slider slider--everywhere blog-hero-carousel{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
      id="Slider-{{ section.id }}"
      aria-live="polite"
      aria-atomic="true"
      data-autoplay="{{ section.settings.auto_rotate }}"
      data-speed="{{ section.settings.change_slides_speed }}"
    >
      {%- for article in articles -%}
        <style>
          #Slide-{{ section.id }}-{{ forloop.index }} .banner__media::after {
            opacity: {{ overlay_opacity }};
          }
        </style>
        <div
          class="slideshow__slide grid__item grid--1-col slider__slide"
          id="Slide-{{ section.id }}-{{ forloop.index }}"
          role="group"
          aria-roledescription="{{ 'sections.slideshow.slide' | t }}"
          aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
          tabindex="-1"
        >
          <div class="slideshow__media banner__media media{% if article.image == blank %} placeholder{% endif %}">
            {%- if article.image -%}
              {%- liquid
                assign height = article.image.width | divided_by: article.image.aspect_ratio | round
                assign sizes = '100vw'
                assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
                assign fetch_priority = 'auto'
                if section.index == 1 and forloop.first
                  assign fetch_priority = 'high'
                endif
              -%}
              {%- if forloop.first -%}
                {{ article.image | image_url: width: 3840 | image_tag: height: height, sizes: sizes, widths: widths, fetchpriority: fetch_priority }}
              {%- else -%}
                {{ article.image | image_url: width: 3840 | image_tag: loading: 'lazy', height: height, sizes: sizes, widths: widths }}
              {%- endif -%}
            {%- else -%}
              {{ 'hero-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>

          <div class="slideshow__text-wrapper banner__content banner__content--middle-left page-width">
            <div class="slideshow__text banner__box content-container color-{{ section.settings.color_scheme }} gradient slideshow__text--left slideshow__text-mobile--left">
              <div class="blog-hero-carousel__meta">
                {%- if article.tags.size > 0 -%}
                  <span class="blog-hero-carousel__category">{{ article.tags.first | upcase }}</span>
                  <span class="blog-hero-carousel__meta-separator">|</span>
                {%- endif -%}
                {%- liquid
                  assign now_s = 'now' | date: '%s' | plus: 0
                  assign pub_s = article.published_at | date: '%s' | plus: 0
                  assign diff_days = now_s | minus: pub_s | divided_by: 86400
                -%}
                <span class="blog-hero-carousel__date">
                  {%- if diff_days == 0 -%}
                    Today
                  {%- elsif diff_days == 1 -%}
                    1 day ago
                  {%- else -%}
                    {{ diff_days }} days ago
                  {%- endif -%}
                </span>
              </div>

              <h2 class="blog-hero-carousel__title">{{ article.title }}</h2>

              {%- if article.excerpt != blank -%}
                <p class="blog-hero-carousel__excerpt">{{ article.excerpt | strip_html | truncate: 150 }}</p>
              {%- endif -%}

              {%- if article.author -%}
                <p class="blog-hero-carousel__author">By {{ article.author }}</p>
              {%- endif -%}

              <a href="{{ article.url }}" class="blog-hero-carousel__cta">Read More</a>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if articles.size > 1 -%}
      <div class="slideshow__controls slider-buttons">
        <button
          type="button"
          class="slider-button slider-button--prev"
          name="previous"
          aria-label="{{ 'sections.slideshow.previous_slideshow' | t }}"
          aria-controls="Slider-{{ section.id }}"
        >
          {% render 'icon-caret' %}
        </button>
        <div class="slider-counter slider-counter--dots">
          <div class="slideshow__control-wrapper">
            {%- for article in articles -%}
              <button
                class="slider-counter__link slider-counter__link--dots link"
                aria-label="{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
                aria-controls="Slider-{{ section.id }}"
              >
                <span class="dot"></span>
              </button>
            {%- endfor -%}
          </div>
        </div>
        <button
          type="button"
          class="slider-button slider-button--next"
          name="next"
          aria-label="{{ 'sections.slideshow.next_slideshow' | t }}"
          aria-controls="Slider-{{ section.id }}"
        >
          {% render 'icon-caret' %}
        </button>

        {%- if section.settings.auto_rotate -%}
          <button
            type="button"
            class="slideshow__autoplay slider-button"
            aria-label="{{ 'sections.slideshow.pause_slideshow' | t }}"
          >
            {%- render 'icon-pause' -%}
            {%- render 'icon-play' -%}
          </button>
        {%- endif -%}
      </div>
    {%- endif -%}
  </slideshow-component>
{%- else -%}
  {%- comment -%} Placeholder when no blog is selected {%- endcomment -%}
  <slideshow-component class="slider-mobile-gutter" role="region" aria-label="Blog hero carousel">
    <div
      class="slideshow banner banner--{{ section.settings.slide_height }} grid grid--1-col slider slider--everywhere blog-hero-carousel{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
      id="Slider-{{ section.id }}"
      aria-live="polite"
      aria-atomic="true"
      data-autoplay="false"
      data-speed="5"
    >
      <div class="slideshow__slide grid__item grid--1-col slider__slide" id="Slide-{{ section.id }}-1" tabindex="-1">
        <div class="slideshow__media banner__media media placeholder">
          {{ 'hero-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
        <div class="slideshow__text-wrapper banner__content banner__content--middle-left page-width">
          <div class="slideshow__text banner__box content-container color-{{ section.settings.color_scheme }} gradient slideshow__text--left slideshow__text-mobile--left">
            <div class="blog-hero-carousel__meta">
              <span class="blog-hero-carousel__category">CATEGORY</span>
              <span class="blog-hero-carousel__meta-separator">|</span>
              <span class="blog-hero-carousel__date">2 days ago</span>
            </div>
            <h2 class="blog-hero-carousel__title">Select a blog to populate this carousel</h2>
            <p class="blog-hero-carousel__excerpt">Choose a blog in the section settings to display your latest articles as a hero carousel.</p>
            <p class="blog-hero-carousel__author">By Author Name</p>
            <span class="blog-hero-carousel__cta">Read More</span>
          </div>
        </div>
      </div>
    </div>
  </slideshow-component>
{%- endif -%}

{%- if request.design_mode -%}
  <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "Blog hero carousel",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "articles_to_show",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3,
      "label": "Articles to show"
    },
    {
      "type": "select",
      "id": "slide_height",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "large",
      "label": "Slide height"
    },
    {
      "type": "range",
      "id": "image_overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "%",
      "label": "Image overlay opacity",
      "default": 20
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Content color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "Auto-rotate slides",
      "default": false
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 3,
      "max": 9,
      "step": 2,
      "unit": "s",
      "label": "Change slides every",
      "default": 5
    }
  ],
  "presets": [
    {
      "name": "Blog hero carousel"
    }
  ]
}
{% endschema %}
