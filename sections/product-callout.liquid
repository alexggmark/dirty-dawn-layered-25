{%- style -%}
  .product-callout {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .product-callout__header {
    margin-bottom: 3rem;
  }

  .product-callout__title {
    font-family: var(--font-heading-family);
    font-size: 4rem;
    font-weight: 400;
    line-height: 1.15;
    margin: 0 0 0.8rem;
  }

  .product-callout__subtitle {
    font-size: 1.4rem;
    color: rgba(var(--color-foreground), 0.65);
    margin: 0;
  }

  .product-callout__card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: rgba(var(--color-foreground), 0.04);
    min-height: 50rem;
  }

  .product-callout__image {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .product-callout__image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 4rem;
  }

  .product-callout__image .placeholder-svg {
    width: 60%;
    height: auto;
  }

  .product-callout__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 5rem 8rem;
    background: #F5F2ED;
  }

  .product-callout__vendor {
    font-size: 1.2rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 500;
    margin: 0 0 1.2rem;
    color: rgb(var(--color-foreground));
  }

  .product-callout__product-title {
    font-family: var(--font-heading-family);
    font-size: 3.6rem;
    font-weight: 400;
    line-height: 1.2;
    margin: 0 0 2rem;
  }

  .product-callout__description {
    font-size: 1.5rem;
    line-height: 1.7;
    color: rgba(var(--color-foreground), 0.7);
    margin: 0 0 2.5rem;
    max-width: 36rem;
  }

  .product-callout__cta {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    min-height: 4.5rem;
    padding: 0 3rem;
    border: 0.1rem solid rgb(var(--color-foreground));
    background: #fff;
    text-decoration: none;
    text-transform: uppercase;
    font: inherit;
    font-size: 1.4rem;
    letter-spacing: 0.1em;
    color: rgb(var(--color-foreground));
    transition: background-color 0.2s, color 0.2s;
    align-self: flex-start;
  }

  .product-callout__cta:hover {
    background-color: rgb(var(--color-foreground));
    color: rgb(var(--color-background));
  }

  @media screen and (max-width: 749px) {
    .product-callout__title {
      font-size: 2.8rem;
    }

    .product-callout__card {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .product-callout__image {
      min-height: 30rem;
    }

    .product-callout__content {
      padding: 3rem 2.5rem;
    }

    .product-callout__product-title {
      font-size: 2.6rem;
    }
  }
{%- endstyle -%}

<div class="product-callout page-width color-{{ section.settings.color_scheme }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
  {%- if section.settings.heading != blank or section.settings.subtitle != blank -%}
    <div class="product-callout__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="product-callout__title">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <p class="product-callout__subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="product-callout__card">
    <div class="product-callout__image">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(max-width: 749px) 100vw, 50vw' }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>

    <div class="product-callout__content">
      {%- if section.settings.vendor != blank -%}
        <p class="product-callout__vendor">{{ section.settings.vendor }}</p>
      {%- endif -%}

      {%- if section.settings.product_title != blank -%}
        <h3 class="product-callout__product-title">{{ section.settings.product_title }}</h3>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <p class="product-callout__description">{{ section.settings.description }}</p>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link }}" class="product-callout__cta">
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product callout",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "This Week's Top Pick"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Section subtitle",
      "default": "Discover our must-haves for visible results and radiant skin"
    },
    {
      "type": "header",
      "content": "Product content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "vendor",
      "label": "Vendor / brand",
      "default": "HYDROPEPTIDE"
    },
    {
      "type": "text",
      "id": "product_title",
      "label": "Product title",
      "default": "Barrier Builder"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "A ceramide barrier repair cream for damaged skin that's been consciously formulated to calm inflammation and irritation."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Section style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 52
    }
  ],
  "presets": [
    {
      "name": "Product callout"
    }
  ]
}
{% endschema %}
