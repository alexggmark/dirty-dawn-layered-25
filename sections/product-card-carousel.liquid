{%- style -%}
  .product-cards {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .product-cards__header {
    margin-bottom: 3rem;
  }

  .product-cards__title {
    font-family: var(--font-heading-family);
    font-size: 4rem;
    font-weight: 400;
    line-height: 1.15;
    margin: 0 0 0.8rem;
  }

  .product-cards__subtitle {
    font-size: 1.4rem;
    color: rgba(var(--color-foreground), 0.65);
    margin: 0;
  }

  .product-cards__slider {
    display: flex;
    gap: var(--grid-desktop-horizontal-spacing, 2rem);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-bottom: 1rem;
    margin-right: calc(-50vw + 50%);
    padding-right: calc(50vw - 50%);
  }

  .product-cards__slider::-webkit-scrollbar {
    display: none;
  }

  .product-cards__card {
    flex: 0 0 auto;
    width: calc(33.333% - var(--grid-desktop-horizontal-spacing, 2rem) * 2 / 3);
    scroll-snap-align: start;
  }

  /* Image area */
  .product-cards__image-wrapper {
    position: relative;
    width: 100%;
    padding-bottom: 110%;
    overflow: hidden;
    margin-bottom: 1.5rem;
    background: rgba(var(--color-foreground), 0.04);
  }

  .product-cards__image-wrapper img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 1.5rem;
  }

  .product-cards__image-wrapper .placeholder-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* Add to bag overlay */
  .product-cards__add-to-bag {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 0 1.2rem 1.2rem;
    opacity: 0;
    transform: translateY(0.5rem);
    transition: opacity 0.25s, transform 0.25s;
    z-index: 2;
  }

  .product-cards__card:hover .product-cards__add-to-bag {
    opacity: 1;
    transform: translateY(0);
  }

  .product-cards__add-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 4.5rem;
    padding: 0 3rem;
    border: 0.1rem solid rgb(var(--color-foreground));
    background: rgb(var(--color-background));
    text-transform: uppercase;
    font: inherit;
    font-size: 1.4rem;
    letter-spacing: 0.1em;
    color: rgb(var(--color-foreground));
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s;
  }

  .product-cards__add-btn:hover {
    background: rgb(var(--color-foreground));
    color: rgb(var(--color-background));
  }

  /* Meta: vendor + rating */
  .product-cards__meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.8rem;
    gap: 1rem;
  }

  .product-cards__vendor-tags {
    font-size: 1.1rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground));
  }

  .product-cards__product-type {
    color: rgba(var(--color-foreground), 0.65);
  }


  .product-cards__card-title {
    font-family: var(--font-heading-family);
    font-size: 2.2rem;
    font-weight: 400;
    line-height: 1.3;
    margin: 0 0 0.8rem;
  }

  .product-cards__card-title a {
    text-decoration: none;
    color: inherit;
  }

  .product-cards__card-title a:hover {
    text-decoration: underline;
  }

  .product-cards__description {
    font-size: 1.3rem;
    line-height: 1.6;
    color: rgba(var(--color-foreground), 0.65);
    margin: 0 0 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .product-cards__price {
    font-size: 1.9rem;
    font-weight: 400;
    margin: 0;
  }

  .product-cards__price--compare {
    text-decoration: line-through;
    color: rgba(var(--color-foreground), 0.5);
    margin-right: 0.8rem;
    font-size: 1.4rem;
  }

  /* Footer */
  .product-cards__footer.slider-buttons {
    display: flex !important;
    justify-content: space-between;
    align-items: center;
    margin-top: 2.5rem;
    padding: 0;
    border: none;
  }

  .product-cards__footer-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .product-cards__view-more {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    text-decoration: none;
    text-transform: uppercase;
    font-size: 1.2rem;
    letter-spacing: 0.1em;
    font-weight: 400;
    color: rgb(var(--color-foreground));
  }

  .product-cards__view-more:hover {
    text-decoration: underline;
  }

  .product-cards__view-more svg {
    width: 1.6rem;
    height: 1.6rem;
  }

  .product-cards__slider-component {
    display: block;
  }

  .product-cards__slider-component .slideshow__slide {
    display: block;
  }

  .product-cards__slider-component .slider--desktop .slider__slide:first-child {
    margin-left: 0;
    scroll-margin-left: 0;
  }

  @media screen and (max-width: 989px) {
    .product-cards__card {
      width: calc(50% - var(--grid-desktop-horizontal-spacing, 2rem) / 2);
    }
  }

  @media screen and (max-width: 749px) {
    .product-cards__title {
      font-size: 2.8rem;
    }

    .product-cards__card {
      width: 75%;
    }

    .product-cards__card-title {
      font-size: 1.8rem;
    }

    .product-cards__add-to-bag {
      opacity: 1;
      transform: translateY(0);
    }

    .product-cards__footer.slider-buttons {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
    }
  }
{%- endstyle -%}

{%- liquid
  assign collection = collections[section.settings.collection]
  assign heading = section.settings.heading
  assign subtitle = section.settings.subtitle
  assign products_to_show = section.settings.products_to_show
-%}

<div class="product-cards page-width color-{{ section.settings.color_scheme }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
  {%- if heading != blank or subtitle != blank -%}
    <div class="product-cards__header">
      {%- if heading != blank -%}
        <h2 class="product-cards__title">{{ heading }}</h2>
      {%- endif -%}
      {%- if subtitle != blank -%}
        <p class="product-cards__subtitle">{{ subtitle }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if collection != blank and collection.products_count > 0 -%}
    <slideshow-component class="product-cards__slider-component">
    <div class="product-cards__slider slider slider--desktop" id="Slider-{{ section.id }}" data-autoplay="false">
      {%- for product in collection.products limit: products_to_show -%}
        <div class="product-cards__card slider__slide slideshow__slide" id="Slide-{{ section.id }}-{{ forloop.index }}">
          <div class="product-cards__image-wrapper">
            <a href="{{ product.url }}">
              {%- if product.featured_image -%}
                {{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(max-width: 749px) 75vw, (max-width: 989px) 50vw, 33vw' }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </a>
            <div class="product-cards__add-to-bag">
              {%- if product.available -%}
                <form method="post" action="{{ routes.cart_add_url }}">
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                  <button type="submit" class="product-cards__add-btn">Add to Bag</button>
                </form>
              {%- else -%}
                <button type="button" class="product-cards__add-btn" disabled>Sold Out</button>
              {%- endif -%}
            </div>
          </div>

          <div class="product-cards__meta">
            <div class="product-cards__vendor-tags">
              {%- if product.vendor != blank -%}
                <span>{{ product.vendor | upcase }}</span>
              {%- endif -%}
              {%- if product.type != blank -%}
                <span class="product-cards__product-type"> / {{ product.type | upcase }}</span>
              {%- endif -%}
            </div>
          </div>

          <h3 class="product-cards__card-title">
            <a href="{{ product.url }}">{{ product.title }}</a>
          </h3>

          {%- if product.description != blank -%}
            <p class="product-cards__description">{{ product.description | strip_html | truncate: 200 }}</p>
          {%- endif -%}

          <p class="product-cards__price">
            {%- if product.compare_at_price > product.price -%}
              <span class="product-cards__price--compare">{{ product.compare_at_price | money }}</span>
            {%- endif -%}
            {{ product.price | money }}
          </p>
        </div>
      {%- endfor -%}
    </div>

    {%- assign product_count = collection.products_count -%}
    {%- if product_count > products_to_show -%}
      {%- assign slide_count = products_to_show -%}
    {%- else -%}
      {%- assign slide_count = product_count -%}
    {%- endif -%}

    <div class="product-cards__footer slider-buttons">
      <div class="product-cards__footer-left">
        <button type="button" class="slider-button slider-button--prev" name="previous" aria-label="Previous" aria-controls="Slider-{{ section.id }}">
          {% render 'icon-caret' %}
        </button>
        <div class="slider-counter slider-counter--dots">
          <div class="slideshow__control-wrapper">
            {%- for i in (1..slide_count) -%}
              <button class="slider-counter__link slider-counter__link--dots link" aria-label="Go to slide {{ i }}" aria-controls="Slider-{{ section.id }}">
                <span class="dot"></span>
              </button>
            {%- endfor -%}
          </div>
        </div>
        <button type="button" class="slider-button slider-button--next" name="next" aria-label="Next" aria-controls="Slider-{{ section.id }}">
          {% render 'icon-caret' %}
        </button>
      </div>

      {%- if collection -%}
        <a href="{{ collection.url }}" class="product-cards__view-more">
          View more products
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 14 10" fill="none">
            <path d="M8.5 1L13 5m0 0L8.5 9M13 5H1" stroke="currentColor" stroke-width="0.75" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      {%- endif -%}
    </div>
    </slideshow-component>

  {%- else -%}
    <p>Select a collection in the section settings to display products.</p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Product card carousel",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Favourites"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Discover our must-haves for visible results and radiant skin"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8,
      "label": "Products to show"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 52
    }
  ],
  "presets": [
    {
      "name": "Product card carousel"
    }
  ]
}
{% endschema %}
