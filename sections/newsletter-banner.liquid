{%- style -%}
  .newsletter-banner {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: 0;
    margin-bottom: 0;
  }

  .section + .newsletter-banner-section {
    margin-top: 0;
  }

  .newsletter-banner-section {
    margin-bottom: 0 !important;
  }

  .newsletter-banner__bg {
    position: relative;
    background: linear-gradient(135deg, #c0c0c0 0%, #e8e8e8 30%, #b8b8b8 60%, #d0d0d0 100%);
    padding: 6rem 2rem;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .newsletter-banner__bg-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .newsletter-banner__card {
    position: relative;
    background: #fff;
    padding: 5rem 6rem;
    max-width: 64rem;
    width: 100%;
    text-align: center;
    z-index: 1;
  }

  .newsletter-banner__heading {
    font-family: var(--font-heading-family);
    font-size: 3.4rem;
    font-weight: 400;
    line-height: 1.2;
    margin: 0 0 1.5rem;
  }

  .newsletter-banner__text {
    font-size: 1.4rem;
    line-height: 1.7;
    color: rgba(var(--color-foreground), 0.7);
    margin: 0 auto 3rem;
    max-width: 48rem;
  }

  .newsletter-banner__form {
    display: flex;
    justify-content: center;
    gap: 0;
    margin-bottom: 2.5rem;
    max-width: 44rem;
    margin-left: auto;
    margin-right: auto;
  }

  .newsletter-banner__input {
    flex: 1;
    border: none;
    border-bottom: 0.1rem solid rgb(var(--color-foreground));
    padding: 1rem 0.5rem;
    font: inherit;
    font-size: 1.4rem;
    background: transparent;
    color: rgb(var(--color-foreground));
    outline: none;
    min-width: 0;
  }

  .newsletter-banner__input::placeholder {
    color: rgba(var(--color-foreground), 0.5);
  }

  .newsletter-banner__input:focus {
    border-bottom-color: rgb(var(--color-foreground));
  }

  .newsletter-banner__submit {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    min-height: 4.5rem;
    padding: 0 3rem;
    border: 0.1rem solid rgb(var(--color-foreground));
    background: #fff;
    text-transform: uppercase;
    font: inherit;
    font-size: 1.4rem;
    letter-spacing: 0.1em;
    color: rgb(var(--color-foreground));
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s;
    white-space: nowrap;
    margin-left: 1.5rem;
  }

  .newsletter-banner__submit:hover {
    background-color: rgb(var(--color-foreground));
    color: rgb(var(--color-background));
  }

  .newsletter-banner__disclaimer {
    font-size: 1.2rem;
    line-height: 1.6;
    color: rgba(var(--color-foreground), 0.5);
    margin: 0 auto;
    max-width: 44rem;
  }

  .newsletter-banner__success {
    font-size: 1.4rem;
    color: rgb(var(--color-foreground));
    margin-bottom: 1rem;
  }

  .newsletter-banner__error {
    font-size: 1.3rem;
    color: #cc0000;
    margin-bottom: 1rem;
  }

  @media screen and (max-width: 749px) {
    .newsletter-banner__bg {
      padding: 3rem 1.5rem;
    }

    .newsletter-banner__card {
      padding: 3rem 2.5rem;
    }

    .newsletter-banner__heading {
      font-size: 2.6rem;
    }

    .newsletter-banner__form {
      flex-direction: column;
      gap: 1.2rem;
    }

    .newsletter-banner__submit {
      margin-left: 0;
      width: 100%;
    }
  }
{%- endstyle -%}

<div class="newsletter-banner{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
  <div class="newsletter-banner__bg">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 1920 | image_tag: class: 'newsletter-banner__bg-image', loading: 'lazy', sizes: '100vw' }}
    {%- endif -%}

    <div class="newsletter-banner__card">
      {%- if section.settings.heading != blank -%}
        <h2 class="newsletter-banner__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <p class="newsletter-banner__text">{{ section.settings.text }}</p>
      {%- endif -%}

      {% form 'customer', class: 'newsletter-banner__form-wrapper' %}
        <input type="hidden" name="contact[tags]" value="newsletter">

        {%- if form.posted_successfully? -%}
          <p class="newsletter-banner__success" id="Newsletter-success--{{ section.id }}" tabindex="-1" autofocus>
            {{ 'newsletter.success' | t }}
          </p>
        {%- endif -%}

        {%- if form.errors -%}
          <p class="newsletter-banner__error" id="Newsletter-error--{{ section.id }}">
            {{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}
          </p>
        {%- endif -%}

        <div class="newsletter-banner__form">
          <input
            id="NewsletterBanner--{{ section.id }}"
            type="email"
            name="contact[email]"
            class="newsletter-banner__input"
            value="{{ form.email }}"
            aria-required="true"
            autocorrect="off"
            autocapitalize="off"
            autocomplete="email"
            {% if form.errors %}
              autofocus
              aria-invalid="true"
              aria-describedby="Newsletter-error--{{ section.id }}"
            {% elsif form.posted_successfully? %}
              aria-describedby="Newsletter-success--{{ section.id }}"
            {% endif %}
            placeholder="{{ section.settings.input_placeholder }}"
            required
          >
          <button type="submit" class="newsletter-banner__submit" name="commit">
            {{ section.settings.button_label }}
          </button>
        </div>
      {% endform %}

      {%- if section.settings.disclaimer != blank -%}
        <p class="newsletter-banner__disclaimer">{{ section.settings.disclaimer }}</p>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Newsletter banner",
  "tag": "section",
  "class": "section newsletter-banner-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image",
      "info": "Optional. Falls back to a metallic gradient."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sign up for our Newsletter"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "Find out in advance about exclusive offers and valuable care tips from our experts – sign up for our newsletter and enjoy a 10% discount on your first order."
    },
    {
      "type": "text",
      "id": "input_placeholder",
      "label": "Input placeholder",
      "default": "Your E-Mail"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe Now"
    },
    {
      "type": "textarea",
      "id": "disclaimer",
      "label": "Disclaimer text",
      "default": "By providing us with your e-mail address and clicking on \"Subscribe now\", you give your consent to receive e-mails from Etre Vous. At the same time, you confirm that you have read and understood our privacy policy. You can cancel your subscription at any time."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 52
    }
  ],
  "presets": [
    {
      "name": "Newsletter banner"
    }
  ]
}
{% endschema %}
