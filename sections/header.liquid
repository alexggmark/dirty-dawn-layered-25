<style>
  header-drawer {
    justify-self: start;
    margin-left: -1.2rem;
  }

  {%- if section.settings.sticky_header_type == 'reduce-logo-size' -%}
    .scrolled-past-header .header__heading-logo-wrapper {
      width: 75%;
    }
  {%- endif -%}

  {%- if section.settings.menu_type_desktop != "drawer" -%}
    @media screen and (min-width: 990px) {
      header-drawer {
        display: none;
      }
    }
  {%- endif -%}

  .menu-drawer-container {
    display: flex;
  }

  .list-menu {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .list-menu--inline {
    display: inline-flex;
    flex-wrap: wrap;
  }

  summary.list-menu__item {
    padding-right: 2.7rem;
  }

  .list-menu__item {
    display: flex;
    align-items: center;
    line-height: calc(1 + 0.3 / var(--font-body-scale));
  }

  .list-menu__item--link {
    text-decoration: none;
    padding-bottom: 1rem;
    padding-top: 1rem;
    line-height: calc(1 + 0.8 / var(--font-body-scale));
  }

  @media screen and (min-width: 750px) {
    .list-menu__item--link {
      padding-bottom: 0.5rem;
      padding-top: 0.5rem;
    }
  }
</style>

{%- style -%}
  .header {
    padding: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px 3rem 10px 3rem;
  }

  .section-header {
    position: sticky; /* This is for fixing a Safari z-index issue. PR #2147 */
    margin-bottom: {{ section.settings.margin_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-header {
      margin-bottom: {{ section.settings.margin_bottom }}px;
    }
  }

  @media screen and (min-width: 990px) {
    .header {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: 5px;
    }
  }

  /* Two-level header: nav row separated from logo row */
  @media screen and (min-width: 990px) {
    .header--top-center .header__inline-menu {
      width: 100%;
      padding-top: 0.5rem;
      padding-bottom: 0;
      margin-top: 0.8rem;
      grid-column: 1 / -1;
      position: relative;
      display: flex;
      justify-content: center;
    }

    /* Full-width divider line that breaks out of page-width */
    .header--top-center .header__inline-menu::before {
      content: '';
      position: absolute;
      top: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 100vw;
      border-top: 0.1rem solid rgba(var(--color-foreground), 0.08);
    }

    .header--top-center .header__inline-menu > .list-menu--inline {
      justify-content: center;
      gap: 1.5rem;
    }

    .header--top-center .header__menu-item {
      text-transform: uppercase;
      font-size: 1.2rem;
      letter-spacing: 0.12em;
      color: rgb(var(--color-foreground));
      font-weight: 400;
    }

    .header--top-center .header__heading-link {
      justify-self: center;
    }

    .header--top-center > .desktop-localization-wrapper {
      grid-area: left-icons;
      justify-self: start;
      display: flex;
      align-items: center;
      justify-content: flex-start;
    }

    .header--top-center > .desktop-localization-wrapper .disclosure__list-wrapper {
      right: auto;
      left: 0;
    }

    /* Keep search visible in icons area for top-center */
    .header--top-center .header__icons .header__search {
      display: inline-flex;
    }

    /* Bag label next to cart icon - desktop only */
    .header__bag-label {
      font-size: 1.2rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      white-space: nowrap;
      color: rgb(var(--color-foreground));
      align-self: center;
      margin-left: 0.75rem;
      text-decoration: none;
    }

    /* Hide Dawn's default cart-count-bubble on desktop */
    .cart-count-bubble {
      display: none;
    }
  }

  /* Country selector fallback (single-country store) */
  .header__country-fallback {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.3rem;
    letter-spacing: 0.04em;
    color: rgb(var(--color-foreground));
    cursor: default;
  }

  .header__country-fallback svg {
    flex-shrink: 0;
  }

  /* Hide account icon */
  .header__icon--account {
    display: none !important;
  }

  /* Mobile logo swap */
  .header__heading-logo--mobile {
    display: none;
  }

  @media screen and (max-width: 989px) {
    .header__heading-logo--desktop {
      display: none;
    }

    .header__heading-logo--mobile {
      display: inline-block;
    }

    /* Mobile: hide text label, show Dawn's default bubble */
    .header__bag-label {
      display: none;
    }

    .cart-count-bubble {
      display: flex;
    }

    /* Mobile header: logo left, icons + burger right */
    .header--top-center {
      display: flex;
      align-items: center;
    }

    .header--top-center .header__heading,
    .header--top-center .header__heading-link {
      justify-self: start;
      text-align: left;
      flex: 1;
    }

    .header--top-center .header__inline-menu {
      display: none;
    }

    .header--top-center > .desktop-localization-wrapper {
      display: none;
    }

    .header--top-center .header__icons {
      order: 2;
      flex: 0 0 auto;
    }

    .header--top-center header-drawer {
      order: 3;
      flex: 0 0 auto;
      margin-left: 0;
    }
  }
{%- endstyle -%}

